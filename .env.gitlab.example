# Purpose: optional GitLab live OpenShift smoke variables.
HF_TOKEN=replace-with-team-hf-read-token

DAEDALUS_HF_SECRET_NAME=daedalus-hf-token

DAEDALUS_RUNTIME_PROFILE_FILE=/path/to/daedalus-runtime.local.env
# DAEDALUS_RUNTIME_PROFILE_B64=
# DAEDALUS_RUNTIME_PROFILE=

KUBECONFIG=/path/to/kubeconfig
# KUBECONFIG_FILE=/path/to/kubeconfig
# KUBECONFIG_B64=

LIVE_OPENSHIFT_SMOKE=1
