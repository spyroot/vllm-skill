# Example Daedalus runtime profile for a cluster with one named GPU node and node-local cache.
# Purpose: document the portable runtime profile shape with non-real placeholder values.

PROJECT="daedalus"
APP="daedalus"
MODEL="Qwen/Qwen3-Coder-30B-A3B-Instruct"
SERVED_MODEL_NAME="Qwen/Qwen3-Coder-30B-A3B-Instruct"

GPU_NODE="gpu-worker-1.example.invalid"
NODE_SELECTOR_KEY="kubernetes.io/hostname"
GPU_COUNT="1"
TENSOR_PARALLEL_SIZE="1"

CACHE_MODE="local"
CACHE_STORAGE_CLASS="local-static-example"
CACHE_PATH="/var/lib/daedalus/model-cache"
CACHE_SIZE="160Gi"

CPU_REQUEST="8"
CPU_LIMIT="24"
MEMORY_REQUEST="64Gi"
MEMORY_LIMIT="128Gi"
