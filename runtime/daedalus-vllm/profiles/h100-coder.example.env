# Example Daedalus profile for a single H100-class GPU serving a coding model.
# Purpose: document an H100-class runtime profile with non-real cluster placeholders.
#
# Do not put tokens, kubeconfig data, registry credentials, or private keys in this profile.
# Store HF_TOKEN and DAEDALUS_API_KEY as separate masked/protected GitLab variables or File variables.

PROJECT="daedalus"
APP="daedalus"
MODEL="Qwen/Qwen3-Coder-30B-A3B-Instruct"
SERVED_MODEL_NAME="Qwen/Qwen3-Coder-30B-A3B-Instruct"
IMAGE="vllm/vllm-openai:v0.21.0"
# For live H100 runs, prefer build-deploy-daedalus-openshift.sh so this base image
# is rebuilt into the OpenShift internal registry and reused from the cluster-local image cache.
IMAGE_STREAM="daedalus"
BASE_IMAGE="vllm/vllm-openai:v0.21.0"

GPU_NODE="replace-with-h100-node-hostname.example.invalid"
NODE_SELECTOR_KEY="kubernetes.io/hostname"
GPU_COUNT="1"
TENSOR_PARALLEL_SIZE="1"

CACHE_MODE="local"
CACHE_PV="daedalus-model-cache-h100-pv"
CACHE_PVC="daedalus-model-cache-h100"
CACHE_STORAGE_CLASS="replace-with-local-storage-class"
CACHE_PATH="/var/lib/daedalus/model-cache-h100"
CACHE_SIZE="512Gi"

MAX_MODEL_LEN="32768"
GPU_MEMORY_UTILIZATION="0.86"
DTYPE="auto"

CPU_REQUEST="32"
CPU_LIMIT="96"
MEMORY_REQUEST="128Gi"
MEMORY_LIMIT="768Gi"

STARTUP_INITIAL_DELAY_SECONDS="30"
STARTUP_PERIOD_SECONDS="15"
STARTUP_FAILURE_THRESHOLD="240"

ROUTE_ENABLED="true"
ROUTE_NAME="daedalus"
ROUTE_HOST=""
ROUTE_TLS_TERMINATION="edge"
API_KEY_SECRET_NAME="daedalus-api-key"
API_KEY_ENV_NAME="DAEDALUS_API_KEY"
